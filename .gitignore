# build artifacts
/build/
# generated by configure.py (Ninja's .ninja_log / .ninja_deps live in build/)
/build.ninja
/build.ninja.d
/release/
*.o
*.i
*.elf

# the copyrighted target binary and the retail link map are NOT committed —
# supply them yourself
/rom/nfs4-f.exe
/rom/NFS4.MAP
/rom/NFS4.SYM

# splat cache
.splache
# splat by-products of configs/nfs4.yaml that the build does not use (the link is
# tools/full_link.py with linkers/link_order.txt)
/asm/data/
/linkers/nfs4.ld
/linkers/nfs4_undefined.ld
/linkers/undefined_funcs_auto.txt
/linkers/undefined_syms_auto.txt
*.pyc
__pycache__/
/expected/
/toolchain.zip
/_tctest/
/_ci*/
recon/_aiinit_syms.txt
/permuter_work/
_backup_permuter/

# decomp.me auto-claim (secret session cookie + token log) — never commit
tools/.decompme_cookie
build/decompme_claims.jsonl

# objdiff report artifact (CI uploads it; not committed)
/nfs4-f_report.binpb

# ASM-pattern-catalog gap snapshot (post-commit hook output)
catalog_gaps.txt
.catalog_gaps.tmp
tools/pattern_db.json
scratchpad_dump.py

# pycparser autogenerated artifacts (permuter side-effect; leaked into w22-a14)
/yacctab.py
/lextab.py
/parser.out
/debug_source.c
scratch/

# Visual Studio local data
.vs/

# objdiff GUI is optional and NOT committed (24MB); drop it next to the
# committed CLI if you want it: tools/objdiff/objdiff.exe
tools/objdiff/objdiff.exe

# verify_region.py gate temp copies (compiled beside the base TU, auto-deleted)
recon/**/*__region_gate*.cpp
recon/**/*__region_gate*.c

# VS Code local workspace data (any depth)
.vscode/

# NFS4 runtime tracing: local emulator copy (270 MB, BIOS inside) stays out of git
tools/duckstation/api-runtime/

# local work areas: session notes, probes, generated outputs -- not published (2026-09-20).
/scratchpad/
/scratch/
/catalog_drafts/

# user tool, kept out of the repository
tools/mod-studio/

# native Linux toolchain (tools/linux/setup_toolchain.sh downloads it; not committed)
/toolchain/
